"privacy_policy_intro" = "NTPUOne 是給國立臺北大學學生使用的校園工具。本政策說明 App 會在本機儲存什麼、哪些資料會送到 Firebase/Google 服務，以及交流身份、通知、小工具、廣告、分析與當機回報如何處理。";
"privacy_policy_effective_date" = "生效日期：2026-08-23";
"privacy_policy_data_title" = "NTPUOne 使用的資訊";
"privacy_policy_data_dashboard" = "首頁、課表、備忘錄、美食、交通、天氣與小工具功能可能使用 UserDefaults、Core Data、App Group 儲存空間，或在 App 啟用時使用 iCloud/Core Data 同步來保存偏好與快取內容。";
"privacy_policy_data_community_identity" = "交流功能會儲存暱稱、裝置識別碼、系所/年級與稱號顯示設定，以及 Google 帳號擁有權中繼資料。登入身分分為三層：北大學生（依學號自動推算系所年級）、外校學生（其他 edu.tw 信箱）與訪客；系所與入學年可隨時手動調整。";
"privacy_policy_data_school_verification" = "學校 Google 驗證會使用 Firebase Authentication 與 Google Sign-In。驗證成功後，App 會儲存學校信箱，並依學生帳號格式推算系所與年級供交流身份顯示。";
"privacy_policy_data_notifications" = "交流區通知目前停用，App 只使用課表與備忘錄的本地通知（不會上傳資料）。若日後重新啟用交流通知，才會儲存訂閱、已看過內容 ID 與推送 token。";
"privacy_policy_data_local_storage" = "小工具會讀取共享的本機 App 資料來顯示任務或校園摘要。解除安裝 App 會移除一般本機資料；iCloud 同步資料則依你的 iCloud 設定處理。";
"privacy_policy_services_title" = "Firebase、廣告、分析與當機回報";
"privacy_policy_services_firebase" = "NTPUOne 使用的 Firebase 服務包含 Firestore、Firebase Authentication、App Check 與相關基礎設施，用於交流內容、個人檔案紀錄與濫用防護。";
"privacy_policy_services_ads" = "Google AdMob 可能處理廣告識別碼、廣告互動資料與裝置資訊，以載入廣告或獎勵廣告。App 也會在本機儲存無廣告獎勵狀態。";
"privacy_policy_services_analytics" = "Google Analytics for Firebase 可能收集 App 使用事件與裝置/App 資訊，用於了解穩定性與功能使用情形。";
"privacy_policy_services_crashlytics" = "Firebase Crashlytics 可能收集當機紀錄、裝置/App 狀態與診斷識別碼，以協助修復問題。";
"privacy_policy_controls_title" = "你的控制權";
"privacy_policy_controls_local_reset" = "「隱私與資料」頁可檢視各類資料的存放位置，並可重新顯示新手教學；不會刪除暱稱或帳號設定。";
"privacy_policy_controls_remote_cleanup" = "交流身份與設定可同步到 Firebase 並綁定已驗證的 Google 帳號；登出後雲端同步暫停，本機設定仍保留，重新登入後恢復。";
"privacy_policy_controls_public_content" = "本機重置不會刪除公開的主題、回覆或餐廳留言。請在「我的內容」中管理綁定目前帳號的公開內容；一般留言可編輯或刪除，管理員可處理異常內容。";
"privacy_policy_controls_uninstall" = "你也可以解除安裝 App，或在系統設定中關閉通知、廣告追蹤權限或 iCloud 功能（若可用），以停止 App 端的相關收集。";
"privacy_policy_links_title" = "控制項、第三方政策與聯絡方式";
