"privacy_policy_intro" = "NTPUOne is a campus utility app for National Taipei University students. This policy explains what the app stores locally, what is sent to Firebase/Google services, and how community identity, notifications, widgets, ads, analytics, and crash reports are handled.";
"privacy_policy_effective_date" = "Effective date: 2026-08-23";
"privacy_policy_data_title" = "Information NTPUOne uses";
"privacy_policy_data_dashboard" = "Dashboard, timetable, memo, food, traffic, weather, and widget features may store preferences and cached content locally with UserDefaults, Core Data, App Group storage, or iCloud/Core Data sync when enabled by the app.";
"privacy_policy_data_community_identity" = "Community features store a nickname, a device identifier, department/year and badge visibility settings, and Google-account ownership metadata. Sign-in identity is tiered: NTPU students (department and year derived from the student ID), external students (other edu.tw addresses), and guests. Department and entry year can be adjusted manually at any time.";
"privacy_policy_data_school_verification" = "School Google verification uses Firebase Authentication and Google Sign-In. When verification succeeds, the app stores the school email and derives department/year from the student account format for community profile display.";
"privacy_policy_data_notifications" = "Community notifications are currently disabled; the app only uses local notifications for courses and memos (nothing is uploaded). If community notifications are re-enabled later, subscriptions, seen-content IDs, and push tokens would be stored.";
"privacy_policy_data_local_storage" = "Widgets read shared local app data to display tasks or campus summaries. Uninstalling the app removes normal local data; iCloud-synced data follows the user’s iCloud settings.";
"privacy_policy_services_title" = "Firebase, ads, analytics, and crash reporting";
"privacy_policy_services_firebase" = "Firebase services used by NTPUOne include Firestore, Firebase Authentication, App Check, and related infrastructure for community content and profile records.";
"privacy_policy_services_ads" = "Google AdMob may process ad identifiers, ad interaction data, and device information to load ads or rewarded ads. The app also stores local ad-free reward state.";
"privacy_policy_services_analytics" = "Google Analytics for Firebase may collect app usage events and device/app information to understand reliability and feature usage.";
"privacy_policy_services_crashlytics" = "Firebase Crashlytics may collect crash logs, device/app state, and diagnostic identifiers to help fix crashes.";
"privacy_policy_controls_title" = "Your controls";
"privacy_policy_controls_local_reset" = "The Privacy & Data page explains where each type of data lives and offers to re-show the first-run tutorial; it does not delete your nickname or account settings.";
"privacy_policy_controls_remote_cleanup" = "Community identity and settings can sync to Firebase under the verified Google account; after sign-out, cloud sync pauses but local settings remain, and they resume after signing back in.";
"privacy_policy_controls_public_content" = "Local reset does not delete public topics, replies, or restaurant comments. Manage public content tied to your account under My Content; you can edit or delete your own comments, and moderators can handle abnormal content.";
"privacy_policy_controls_uninstall" = "You may also stop app-side collection by uninstalling the app or disabling notifications, ads tracking permissions, or iCloud features in system settings where available.";
"privacy_policy_links_title" = "Controls, third-party policies, and contact";
